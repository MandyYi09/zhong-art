# Public values safe to expose to browser applications.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=zhong-art
KEYCLOAK_PUBLIC_CLIENT_ID=zhong-public
KEYCLOAK_ADMIN_CLIENT_ID=zhong-admin

# Server-side values. Obtain the secret from Keycloak only after importing the
# realm, and inject it through the deployment secret store. Never commit it.
KEYCLOAK_ISSUER=http://localhost:8080/realms/zhong-art
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/zhong-art/protocol/openid-connect/certs
KEYCLOAK_SERVER_CLIENT_ID=zhong-server
KEYCLOAK_SERVER_CLIENT_SECRET=

# Replace these non-routable placeholders in realm.json before production use.
PUBLIC_APP_ORIGIN=https://public-app.example.invalid
PUBLIC_APP_REDIRECT_URI=https://public-app.example.invalid/auth/callback
PUBLIC_APP_LOGOUT_REDIRECT_URI=https://public-app.example.invalid/
ADMIN_APP_ORIGIN=https://admin-app.example.invalid
ADMIN_APP_REDIRECT_URI=https://admin-app.example.invalid/auth/callback
ADMIN_APP_LOGOUT_REDIRECT_URI=https://admin-app.example.invalid/
