{
  "realm": "zhong-art",
  "displayName": "Zhong Art",
  "enabled": true,
  "sslRequired": "external",
  "attributes": {
    "frontendUrl": "http://localhost:8080"
  },
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard Zhong Art application access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Zhong Art administrative application access",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "groups": [
    {
      "name": "users",
      "realmRoles": [
        "user"
      ]
    },
    {
      "name": "administrators",
      "realmRoles": [
        "user",
        "admin"
      ]
    }
  ],
  "users": [
    {
      "username": "user",
      "email": "user@localhost",
      "firstName": "Local",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/users"],
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin",
      "email": "admin@localhost",
      "firstName": "Local",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/administrators"],
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "zhong-api",
      "description": "Adds the Zhong Art server audience to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "zhong-server-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "zhong-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "zhong-public",
      "name": "Zhong Art public app",
      "description": "Browser-based public application; Authorization Code flow with PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "https://public-app.example.invalid",
      "baseUrl": "/",
      "redirectUris": [
        "https://public-app.example.invalid/",
        "http://localhost:3000/",
        "http://localhost:3000/silent-check-sso.html"
      ],
      "webOrigins": [
        "https://public-app.example.invalid",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://public-app.example.invalid/##http://localhost:3000/"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email",
        "zhong-api"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "zhong-admin",
      "name": "Zhong Art admin app",
      "description": "Browser-based administration application; Authorization Code flow with PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "https://admin-app.example.invalid",
      "baseUrl": "/",
      "redirectUris": [
        "https://admin-app.example.invalid/auth/callback",
        "http://localhost:3001/auth/callback"
      ],
      "webOrigins": [
        "https://admin-app.example.invalid",
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://admin-app.example.invalid/##http://localhost:3001/"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email",
        "zhong-api"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "zhong-server",
      "name": "Zhong Art server",
      "description": "Confidential server client for service-to-service authentication and API audience validation",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ]
}
