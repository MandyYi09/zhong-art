{
  "name": "modern-shuilu",
  "private": true,
  "workspaces": ["apps/web", "apps/admin", "apps/server"],
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @modern-shuilu/server",
    "db:seed": "npm run db:seed --workspace @modern-shuilu/server",
    "dev": "concurrently -n api,web,admin -c blue,green,magenta \"npm run dev --workspace @modern-shuilu/server\" \"npm run dev --workspace @modern-shuilu/web\" \"npm run dev --workspace @modern-shuilu/admin\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "keycloak:validate": "./infra/keycloak/validate.sh"
    ,"smoke:integration": "npm run smoke:integration --workspace @modern-shuilu/server"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
